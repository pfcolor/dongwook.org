{
  "name": "dongwook-comments",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // 댓글 저장소. database_id는 `wrangler d1 create dongwook-comments`가 알려 주는 값으로 바꾼다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dongwook-comments",
      "database_id": "52b4a4d3-0a13-4360-8387-0c7821c1e818"
    }
  ],

  // 명백한 욕설·시비 판별(Workers AI). 계정 단위 무료 한도(하루 10,000 뉴런)를 쓴다.
  "ai": { "binding": "AI" },

  // 알림 메일 발송. 받는 주소는 비밀 값(NOTIFY_TO)으로 둬서 저장소에 남기지 않는다.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "SITE_ORIGIN": "https://dongwook.org",
    "MAIL_FROM": "comments@dongwook.org"
  }

  // 비밀 값(wrangler secret put): ADMIN_SECRET, NOTIFY_TO, HASH_SALT, TURNSTILE_SECRET(선택)
  // 로컬 개발용 값은 .dev.vars에 둔다(저장소에 올리지 않음).
}
