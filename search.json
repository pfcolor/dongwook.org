---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for post in site.posts %}
  {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}},
{%- endfor %}
{%- assign pages = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.url != '/search/'" %}
{%- for p in pages %}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "date": "", "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
